	import { ComponentPreview } from '$lib';
	import Testimonial from '$lib/components/ui-registry/Testimonial.svelte';
	import { TestimonialSource } from '$lib/components/ui-registry/demo-sources';
	import type { ComponentPreviewControl } from '$lib/components/docs/component-preview/types';

	const controls: ComponentPreviewControl[] = [
		{
			type: 'text',
			name: 'name',
			label: 'Имя',
			defaultValue: 'Анна Иванова'
		},
		{
			type: 'text',
