	.inspector-dot { width: .5rem; height: .5rem; border-radius: 50%; background: #a3e635; }
	.hint { margin: 0 0 0 auto; }
	@media (max-width: 700px) { .diagram-toolbar { align-items: flex-start; flex-direction: column; } .hint { display: none; } .diagram-workspace { min-height: 520px; } }
</style>
