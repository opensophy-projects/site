<script lang="ts">
	import { ComponentPreview } from '$lib';
	import BarChart from '$lib/components/charts/BarChart.svelte';
	import { chartSources } from '$lib/components/charts/chart-sources';
	import {
		monthlyData,
		monthlyConfig,
		gradientConfig,
		shortMonth
	} from '$lib/components/charts/chart-demo-data';
	import type { ComponentPreviewControl } from '$lib/components/docs/component-preview/types';

	const variants = ['default', 'hatched', 'duotone', 'duotone-reverse', 'gradient', 'stripped'];

	const controls: ComponentPreviewControl[] = [
		{
			type: 'select',
			name: 'variant',
			label: 'Заливка',
			defaultValue: 'default',
			options: variants.map((v) => ({ label: v, value: v }))
		},
		{
			type: 'select',
			name: 'stackType',
			label: 'Стек',
			defaultValue: 'default',
			options: ['default', 'stacked', 'percent'].map((v) => ({ label: v, value: v }))
		},
		{
			type: 'select',
			name: 'layout',
			label: 'Раскладка',
			defaultValue: 'vertical',
			options: ['vertical', 'horizontal'].map((v) => ({ label: v, value: v }))
		},
		{ type: 'number', name: 'barRadius', label: 'Скругление', defaultValue: 2, min: 0, max: 12, step: 1 },
		{ type: 'boolean', name: 'glowing', label: 'Свечение', defaultValue: false },
		{ type: 'boolean', name: 'highlight', label: 'Подсветка наведения', defaultValue: false },
		{ type: 'boolean', name: 'buffer', label: 'Буферный столбец', defaultValue: false },
		{ type: 'boolean', name: 'brush', label: 'Браш', defaultValue: false },
		{ type: 'boolean', name: 'isLoading', label: 'Загрузка', defaultValue: false }
	];
</script>

# Столбчатая диаграмма

`BarChart` — столбчатая диаграмма на Svelte 5 без сторонних библиотек. Поддерживает шесть вариантов заливки, обычный и процентный стек, горизонтальную раскладку, свечение, подсветку столбца под курсором и «буферный» последний столбец для незавершённого периода.

## Интерактивное демо

<ComponentPreview controls={controls} sources={chartSources.bar}>
	{#snippet children(values)}
		<div class="h-[380px] w-full p-4 pt-12">
			<BarChart
				data={monthlyData}
				config={monthlyConfig}
				xDataKey="month"
				variant={values.variant}
				stackType={values.stackType}
				layout={values.layout}
				barRadius={values.barRadius}
				glowing={values.glowing}
				enableHoverHighlight={values.highlight}
				bufferBar={values.buffer}
				isClickable
				legend={{ isClickable: true }}
				brush={values.brush ? { formatLabel: shortMonth } : false}
				isLoading={values.isLoading}
				xAxis={values.layout === 'horizontal' ? false : { tickFormatter: shortMonth }}
				yAxis={values.layout === 'horizontal' ? { tickFormatter: shortMonth } : false}
				class="h-full w-full"
			/>
		</div>
	{/snippet}
</ComponentPreview>

## Использование

```svelte
<script lang="ts">
	import BarChart from '$lib/components/charts/BarChart.svelte';
	import type { ChartConfig } from '$lib/components/charts/chart-utils';

	const config = {
		desktop: { label: 'Десктоп', colors: { light: ['#047857'], dark: ['#10b981'] } },
		mobile: { label: 'Мобильные', colors: { light: ['#be123c'], dark: ['#f43f5e'] } }
	} satisfies ChartConfig;
</script>

<BarChart
	{data}
	{config}
	xDataKey="month"
	legend={{ isClickable: true }}
	series={[
		{ dataKey: 'desktop', variant: 'hatched', isClickable: true },
		{ dataKey: 'mobile', variant: 'duotone', isClickable: true }
	]}
	class="h-[320px] w-full"
/>
```

## Примеры

### Варианты заливки

<div class="grid gap-4 md:grid-cols-2">
{#each variants as v (v)}
	<div class="rounded-lg border border-border p-3">
		<div class="mb-2 font-mono text-xs text-foreground-muted">variant="{v}"</div>
		<BarChart data={monthlyData.slice(0, 8)} config={monthlyConfig} xDataKey="month" variant={v} xAxis={{ tickFormatter: shortMonth }} class="h-[220px] w-full" />
	</div>
{/each}
</div>

```svelte
<BarChart {data} {config} xDataKey="month" variant="duotone" />
```

### Стек и процентный стек

<div class="grid gap-4 md:grid-cols-2">
	<BarChart data={monthlyData} config={monthlyConfig} xDataKey="month" stackType="stacked" legend xAxis={{ tickFormatter: shortMonth }} class="h-[260px] w-full" />
	<BarChart data={monthlyData} config={monthlyConfig} xDataKey="month" stackType="percent" yAxis legend xAxis={{ tickFormatter: shortMonth }} class="h-[260px] w-full" />
</div>

```svelte
<BarChart {data} {config} xDataKey="month" stackType="stacked" legend />
<BarChart {data} {config} xDataKey="month" stackType="percent" yAxis legend />
```

### Горизонтальная раскладка

<BarChart data={monthlyData.slice(0, 6)} config={monthlyConfig} xDataKey="month" layout="horizontal" barRadius={4} legend yAxis={{ tickFormatter: shortMonth }} class="h-[320px] w-full" />

```svelte
<BarChart {data} {config} xDataKey="month" layout="horizontal" barRadius={4} legend />
```

### Подсветка, свечение и буферный столбец

<div class="grid gap-4 md:grid-cols-2">
	<BarChart data={monthlyData} config={monthlyConfig} xDataKey="month" enableHoverHighlight glowing xAxis={{ tickFormatter: shortMonth }} class="h-[260px] w-full" />
	<BarChart data={monthlyData} config={monthlyConfig} xDataKey="month" bufferBar isClickable legend={{ isClickable: true }} xAxis={{ tickFormatter: shortMonth }} class="h-[260px] w-full" />
</div>

```svelte
<BarChart {data} {config} xDataKey="month" enableHoverHighlight glowing />
<BarChart {data} {config} xDataKey="month" bufferBar isClickable legend={{ isClickable: true }} />
```

### Градиентные цвета и тултип frosted-glass

<BarChart data={monthlyData} config={gradientConfig} xDataKey="month" barRadius={4} tooltip={{ variant: 'frosted-glass', roundness: 'xl', defaultIndex: 7 }} backgroundVariant="dots" xAxis={{ tickFormatter: shortMonth }} class="h-[280px] w-full" />

```svelte
<BarChart {data} {config} xDataKey="month" barRadius={4} backgroundVariant="dots"
	tooltip={{ variant: 'frosted-glass', roundness: 'xl', defaultIndex: 7 }} />
```

### Состояние загрузки

<BarChart data={[]} config={monthlyConfig} isLoading class="h-[240px] w-full" />

