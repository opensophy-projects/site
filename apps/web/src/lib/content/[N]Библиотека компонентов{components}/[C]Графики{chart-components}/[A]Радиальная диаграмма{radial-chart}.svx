			defaultValue: 'full',
			options: ['full', 'semi'].map((v) => ({ label: v, value: v }))
		},
		{ type: 'number', name: 'barSize', label: 'Толщина', defaultValue: 14, min: 4, max: 30, step: 1 },
		{ type: 'number', name: 'cornerRadius', label: 'Скругление', defaultValue: 5, min: 0, max: 15, step: 1 },
		{ type: 'number', name: 'max', label: 'Максимум (0 — авто)', defaultValue: 0, min: 0, max: 600, step: 25 },
