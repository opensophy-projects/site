<script lang="ts">
	import { ComponentPreview } from '$lib';
	import LineChart from '$lib/components/charts/LineChart.svelte';
	import { chartSources } from '$lib/components/charts/chart-sources';
	import { BACKGROUND_VARIANTS } from '$lib/components/charts/ChartBackground.svelte';
	import {
		monthlyData,
		monthlyConfig,
		gradientConfig,
		shortMonth
	} from '$lib/components/charts/chart-demo-data';
	import type { ComponentPreviewControl } from '$lib/components/docs/component-preview/types';

	const controls: ComponentPreviewControl[] = [
		{
			type: 'select',
			name: 'curveType',
			label: 'Кривая',
			defaultValue: 'monotone',
			options: ['linear', 'monotone', 'natural', 'step', 'bump'].map((v) => ({ label: v, value: v }))
		},
		{
			type: 'select',
			name: 'strokeVariant',
			label: 'Линия',
			defaultValue: 'solid',
			options: ['solid', 'dashed', 'animated-dashed'].map((v) => ({ label: v, value: v }))
		},
		{
			type: 'select',
			name: 'dot',
			label: 'Точки',
			defaultValue: 'border',
			options: ['none', 'default', 'border', 'colored-border'].map((v) => ({ label: v, value: v }))
		},
		{
			type: 'select',
			name: 'background',
			label: 'Фон',
			defaultValue: 'none',
			options: ['none', ...BACKGROUND_VARIANTS].map((v) => ({ label: v, value: v }))
		},
		{ type: 'boolean', name: 'glowing', label: 'Свечение', defaultValue: true },
		{ type: 'boolean', name: 'buffer', label: 'Буферная линия', defaultValue: false },
		{ type: 'boolean', name: 'brush', label: 'Браш', defaultValue: false },
		{ type: 'boolean', name: 'yAxis', label: 'Ось Y', defaultValue: false },
		{ type: 'boolean', name: 'isLoading', label: 'Загрузка', defaultValue: false }
