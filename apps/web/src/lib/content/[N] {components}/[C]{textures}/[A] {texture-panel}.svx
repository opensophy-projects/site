		<div class="w-full p-4">
			<TexturePanel variant={values.variant as 'dashed' | 'grid' | 'dots' | 'lines-h' | 'lines-v' | 'blank'} class="min-h-32" />
		</div>
	{/snippet}
</ComponentPreview>

## Все варианты

