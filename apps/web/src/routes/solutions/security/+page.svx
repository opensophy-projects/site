---
title: Безопасность
description: Услуги безопасности — автоматическая проверка (SAST/DAST/SCA), пентесты, поиск утечек и секретов, триаж уязвимостей.
---

<script lang="ts">
	import SiteMenu from '$lib/components/ui/SiteMenu.svelte';
	import { siteConfig } from '$lib/config/site';
	import Email from 'carbon-icons-svelte/lib/Email.svelte';
	import LocationCurrent from 'carbon-icons-svelte/lib/LocationCurrent.svelte';

	const telegramUrl = siteConfig.links.telegram;
	const telegramHandle = '@opensophy';
	const emailUrl = `mailto:${siteConfig.links.email}`;
	const emailLabel = siteConfig.links.email;

	// Card 1 — security analysis badges
	const saRows = [
		{ badges: [
			{ label: 'SCA', accent: true },
			{ label: 'SAST', accent: false },
		]},
		{ badges: [
			{ label: 'DAST', accent: true },
			{ label: 'LINT', accent: false },
		]},
		{ badges: [
			{ label: 'WAF', accent: false },
			{ label: 'IaC Scan', accent: true },
		]},
	];

	// Card 3 — secret leak lines
	const leakLines = [
		{ width: '82%', accent: false },
		{ width: '55%', accent: false },
		{ width: '90%', accent: true },
		{ width: '48%', accent: false },
		{ width: '72%', accent: false },
		{ width: '38%', accent: false },
	];

	// Card 4 — vulnerability triage queue
	const triageItems = [
		{ severity: 'critical', label: 'SQL Injection — /api/users' },
		{ severity: 'high', label: 'XSS — search page' },
		{ severity: 'medium', label: 'Outdated dependency — lodash' },
		{ severity: 'low', label: 'Missing security header' },
		{ severity: 'info', label: 'Verbose error message' },
	];
</script>

<main class="security-page">
	<SiteMenu />

	<div class="security-shell">
		<div class="page-header">
			<p class="eyebrow">решения</p>
			<h1>Безопасность</h1>
			<p class="page-subtitle">
				Встраиваю безопасность в каждый этап — от автоматической проверки кода
				до ручного пентеста и поиска утечек данных.
			</p>
		</div>

		<section class="cards-grid">
			<!-- Card 1: Automated Security Testing (CI/CD + SAST/DAST/SCA) -->
			<div class="card-shell">
				<div class="card-inner">
					<div class="visual-area" style="height: 9.5rem;">
						<div class="sa-visual" aria-hidden="true">
							{#each saRows as row, i (i)}
								<div class="sa-row" style="transform: translateX({i === 0 ? '-1.5rem' : i === 1 ? '1.5rem' : '-0.75rem'})">
									{#each row.badges as badge (badge.label)}
										<span class="sa-badge" class:sa-badge-accent={badge.accent}>
											{badge.label}
										</span>
									{/each}
								</div>
							{/each}
						</div>
					</div>
					<div class="card-body">
						<p class="card-badge">Услуга</p>
						<h3 class="card-title">
							Настройка автоматической проверки безопасности (CI/CD + SAST/DAST/SCA)
						</h3>
						<p class="card-desc">
							Подключаю SAST, DAST и SCA к CI/CD, чтобы проект автоматически
							проверял код, работающее приложение и зависимости на уязвимости при
							каждом обновлении.
						</p>
					</div>
				</div>
			</div>

			<!-- Card 2: Pentest (blackbox, graybox, whitebox) -->
			<div class="card-shell">
				<div class="card-inner">
					<div class="visual-area" style="height: 9.5rem; overflow: hidden; position: relative;">
						<div class="pt-visual" aria-hidden="true">
							<div class="pt-vline"></div>
							<div class="pt-arc-outer"></div>
							<div class="pt-arc-outer-accent"></div>
							<div class="pt-arc-inner"></div>
							<div class="pt-arc-inner-accent"></div>
						</div>
					</div>
					<div class="card-body">
						<p class="card-badge">Услуга</p>
						<h3 class="card-title">
							Проверка безопасности (blackbox, graybox, whitebox)
						</h3>
						<p class="card-desc">
							Проверяю сайт, приложение или API в подходящем формате: снаружи, с
							частичным доступом или с полным доступом к коду и ручной проверкой
							находок.
						</p>
					</div>
				</div>
			</div>

			<!-- Card 3: Secret Leak Search -->
			<div class="card-shell">
				<div class="card-inner">
					<div class="visual-area" style="height: 9.5rem;">
						<div class="leak-lines-visual" aria-hidden="true">
							{#each leakLines as line (line.width)}
								<div class="leak-line-row">
									<span class="leak-line-stroke" class:leak-line-accent={line.accent} style="width: {line.width}">
										{#if line.accent}
											<span class="leak-line-mask"></span>
										{/if}
									</span>
								</div>
							{/each}
						</div>
					</div>
					<div class="card-body">
						<p class="card-badge">Услуга</p>
						<h3 class="card-title">Поиск утечек и секретов</h3>
						<p class="card-desc">
							Ищу хардкод-пароли, ключи API и токены в репозиториях и конфигах
							с помощью Gitleaks и аналогов. Нахожу, что уже попало в git-историю,
							и помогаю отозвать скомпрометированные секреты.
						</p>
					</div>
				</div>
			</div>

			<!-- Card 4: Vulnerability Triage & Reporting -->
			<div class="card-shell">
				<div class="card-inner">
					<div class="visual-area" style="height: 9.5rem;">
						<div class="triage-visual" aria-hidden="true">
							{#each triageItems as item (item.label)}
								<div class="triage-row">
									<span class="triage-dot triage-dot-{item.severity}"></span>
									<span class="triage-bar"></span>
									<span class="triage-label">{item.label}</span>
								</div>
							{/each}
						</div>
					</div>
					<div class="card-body">
						<p class="card-badge">Услуга</p>
						<h3 class="card-title">Триаж и отчётность по уязвимостям</h3>
						<p class="card-desc">
							Разбираю отчёты сканеров и bug bounty, отсеиваю ложные срабатывания
							и расставляю приоритеты: что чинить срочно, а что может подождать.
							Отчёт — понятным языком, с рекомендациями по устранению.
						</p>
					</div>
				</div>
			</div>

			<!-- Card 5: Data Leak Search (full-width) -->
			<div class="card-shell card-full-width">
				<div class="card-inner" style="flex-direction: row; min-height: 10rem;">
					<div class="visual-area" style="width: 44%; height: auto; flex-shrink: 0; position: relative;">
						<div class="datal-leak-visual" aria-hidden="true">
							<svg
								viewBox="0 0 180 140"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
								style="animation: bookFloat 6.8s ease-in-out infinite;"
							>
								<circle
									cx="78"
									cy="62"
									r="34"
									fill="color-mix(in srgb, currentColor 8%, transparent)"
									stroke="color-mix(in srgb, currentColor 24%, transparent)"
									stroke-width="2"
								/>
								<path
									d="M103 87L139 123"
									stroke="color-mix(in srgb, currentColor 32%, transparent)"
									stroke-width="8"
									stroke-linecap="round"
								/>
								<path
									d="M59 55C68 47 82 45 93 52"
									stroke="var(--accent, #f43f5e)"
									stroke-width="2"
									stroke-linecap="round"
								/>
								<path
									d="M54 72H101"
									stroke="color-mix(in srgb, currentColor 16%, transparent)"
									stroke-width="1.5"
									stroke-linecap="round"
								/>
								<path
									d="M62 84H93"
									stroke="color-mix(in srgb, currentColor 16%, transparent)"
									stroke-width="1.5"
									stroke-linecap="round"
								/>
								<circle
									cx="121"
									cy="32"
									r="4"
									fill="var(--accent, #f43f5e)"
									opacity="0.8"
								/>
								<circle
									cx="38"
									cy="104"
									r="3"
									fill="color-mix(in srgb, currentColor 26%, transparent)"
								/>
							</svg>
						</div>
					</div>
					<div class="card-body" style="justify-content: center;">
						<p class="card-badge">Услуга</p>
						<h3 class="card-title">Поиск утечек данных (Data Leak Search)</h3>
						<p class="card-desc">
							Ищу, не утекли ли данные компании или пользователя: базы, пароли,
							документы, переписки, открытые базы и слитые архивы.
						</p>
					</div>
				</div>
			</div>
		</section>

		<hr class="divider" />

		<div class="contacts-section">
			<h2 class="contacts-heading">Заказать услугу</h2>
			<p class="contacts-text">
				Напишите через удобный вам канал — отвечу в течение двух рабочих дней,
				обсудим задачу и сроки. Цена обсуждается индивидуально в зависимости
				от объёма работ и сложности.
			</p>
			<div class="contacts-links">
				<a class="contact-card" href={telegramUrl} target="_blank" rel="noreferrer">
					<span class="contact-icon"><LocationCurrent size={20} /></span>
					<span class="contact-info">
						<span class="contact-label">Telegram</span>
						<span class="contact-value">{telegramHandle}</span>
					</span>
				</a>
				<a class="contact-card" href={emailUrl}>
					<span class="contact-icon"><Email size={20} /></span>
					<span class="contact-info">
						<span class="contact-label">Email</span>
						<span class="contact-value">{emailLabel}</span>
					</span>
				</a>
			</div>
		</div>
	</div>
</main>

<style>
	/* ─── Page Layout (same pattern as service-policy) ─────────── */
	:global([data-doc-content]) {
		max-width: none !important;
		width: 100% !important;
		margin-inline: auto;
	}

	.security-page {
		min-height: 100dvh;
		background: var(--background);
		color: var(--foreground);
		padding: 7rem 1rem 5rem;
	}

	.security-shell {
		max-width: 52rem;
		margin: 0 auto;
	}

	/* ─── Page Header ───────────────────────────────────────────── */
	.page-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.eyebrow {
		font-size: 0.8rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--foreground-muted);
		margin: 0 0 0.75rem;
	}

	.page-header h1 {
		font-size: clamp(2.25rem, 6vw, 4rem);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.04em;
		color: var(--foreground);
		margin: 0 0 1rem;
	}

	.page-subtitle {
		max-width: 32rem;
		margin: 0 auto;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--foreground-muted);
	}

	/* ─── Cards Grid ───────────────────────────────────────────── */
	.cards-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		width: 100%;
		box-sizing: border-box;
	}

	.card-full-width {
		grid-column: 1 / -1;
	}

	@media (max-width: 600px) {
		.cards-grid {
			grid-template-columns: 1fr;
		}
		.card-full-width .card-inner {
			flex-direction: column !important;
		}
		.card-full-width .visual-area {
			width: 100% !important;
			height: 9rem !important;
		}
	}

	/* ─── Card Shell ───────────────────────────────────────────── */
	.card-shell {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		border-radius: 0.75rem;
		background: var(--background-inset);
		padding: 0.375rem;
		box-shadow:
			inset 0px 1px 1px -0.5px rgba(0, 0, 0, 0.06),
			inset 0px 3px 3px -1.5px rgba(0, 0, 0, 0.06),
			inset 0px 6px 6px -3px rgba(0, 0, 0, 0.06),
			inset 0 -0.5px rgba(255, 255, 255, 0.08),
			inset 0 0 0 0.5px oklch(from var(--highlight) l c h / 8%);
	}

	.card-inner {
		position: relative;
		border-radius: 0.5rem;
		border: 1px solid var(--border);
		background: var(--background);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		min-height: 18rem;
		box-shadow:
			0 -0.5px rgba(255, 255, 255, 0.08),
			0 4px 8px rgba(0, 0, 0, 0.06),
			0 0 0 0.5px oklch(from var(--highlight) l c h / 8%),
			0 1px 6px -4px #000;
	}

	.visual-area {
		position: relative;
		height: 9rem;
		overflow: hidden;
		flex-shrink: 0;
	}

	.card-body {
		padding: 1rem 1.25rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.card-badge {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--foreground-muted);
		margin-bottom: 0.25rem;
	}

	.card-title {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--foreground);
		margin: 0;
	}

	.card-desc {
		font-size: 0.82rem;
		line-height: 1.6;
		color: var(--foreground-muted);
		margin: 0;
		flex: 1;
	}

	@media (min-width: 768px) {
		.card-title {
			font-size: 1.125rem;
		}
		.card-desc {
			font-size: 0.9rem;
		}
		.card-badge {
			font-size: 0.65rem;
		}
	}

	/* ─── Card 1: Security Analysis badges ─────────────────────── */
	.sa-visual {
		display: flex;
		flex-direction: column;
		justify-content: space-around;
		padding: 1.1rem 0 0.5rem;
		height: 100%;
		gap: 0;
	}

	.sa-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.1rem;
		gap: 0.75rem;
	}

	.sa-row::before {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto 0;
		height: 1px;
		background: var(--border);
	}

	.sa-badge {
		position: relative;
		display: inline-flex;
		align-items: center;
		height: 1.75rem;
		padding: 0 0.65rem;
		border-radius: 999px;
		background: var(--background);
		border: 1px solid var(--border);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--foreground-muted);
		white-space: nowrap;
		z-index: 2;
	}

	.sa-badge-accent {
		color: var(--accent, #f43f5e);
		border-color: color-mix(in srgb, var(--accent, #f43f5e) 30%, transparent);
	}

	/* ─── Card 2: Pentest concentric arcs ──────────────────────── */
	.pt-visual {
		position: absolute;
		inset: 0;
	}

	.pt-vline {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 1px;
		background: color-mix(in srgb, var(--foreground) 12%, transparent);
	}

	.pt-arc-outer {
		position: absolute;
		left: -3rem;
		right: -3rem;
		top: 1.2rem;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
	}

	.pt-arc-outer-accent {
		position: absolute;
		left: -3rem;
		right: -3rem;
		top: 1.2rem;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid var(--accent, #f43f5e);
		-webkit-mask-image: linear-gradient(90deg, transparent 50%, black 50%);
		mask-image: linear-gradient(90deg, transparent 50%, black 50%);
	}

	.pt-arc-inner {
		position: absolute;
		left: 0;
		right: 0;
		top: 3.5rem;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--foreground) 10%, transparent);
	}

	.pt-arc-inner-accent {
		position: absolute;
		left: 0;
		right: 0;
		top: 3.5rem;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid var(--accent, #f43f5e);
		-webkit-mask-image: linear-gradient(90deg, black 50%, transparent 50%);
		mask-image: linear-gradient(90deg, black 50%, transparent 50%);
	}

	/* ─── Card 3: Secret Leak lines ────────────────────────────── */
	.leak-lines-visual {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.45rem;
		width: 100%;
		height: 100%;
		padding: 0 0.5rem;
	}

	.leak-line-row {
		display: flex;
		align-items: center;
	}

	.leak-line-stroke {
		height: 0.5rem;
		border-radius: 2px;
		background: color-mix(in srgb, var(--foreground) 12%, transparent);
		position: relative;
	}

	.leak-line-accent {
		background: color-mix(in srgb, var(--accent, #f43f5e) 45%, transparent);
	}

	.leak-line-mask {
		position: absolute;
		left: 55%;
		top: 0;
		bottom: 0;
		width: 30%;
		background: var(--background);
		border: 1px dashed color-mix(in srgb, var(--accent, #f43f5e) 50%, transparent);
		border-radius: 2px;
	}

	/* ─── Card 4: Triage queue ─────────────────────────────────── */
	.triage-visual {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		height: 100%;
		padding: 0 0.75rem;
	}

	.triage-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.triage-dot {
		flex-shrink: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
	}

	.triage-dot-critical {
		background: var(--accent, #f43f5e);
		box-shadow: 0 0 6px color-mix(in srgb, var(--accent, #f43f5e) 50%, transparent);
	}

	.triage-dot-high {
		background: color-mix(in srgb, var(--accent, #f43f5e) 60%, transparent);
	}

	.triage-dot-medium {
		background: color-mix(in srgb, var(--foreground) 35%, transparent);
	}

	.triage-dot-low {
		background: color-mix(in srgb, var(--foreground) 20%, transparent);
	}

	.triage-dot-info {
		background: color-mix(in srgb, var(--foreground) 12%, transparent);
	}

	.triage-bar {
		flex: 1;
		height: 0.4rem;
		border-radius: 2px;
		background: color-mix(in srgb, var(--foreground) 10%, transparent);
	}

	.triage-label {
		flex-shrink: 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.55rem;
		font-weight: 600;
		color: var(--foreground-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 8rem;
	}

	/* ─── Card 5: Data Leak magnifier ──────────────────────────── */
	.datal-leak-visual {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.datal-leak-visual svg {
		width: min(82%, 12rem);
		height: auto;
		opacity: 0.9;
	}

	/* ─── Divider ──────────────────────────────────────────────── */
	.divider {
		width: 100%;
		max-width: 36rem;
		margin: 3rem auto;
		border: none;
		border-top: 1px solid var(--border);
	}

	/* ─── Contacts Section ─────────────────────────────────────── */
	.contacts-section {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.contacts-heading {
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--foreground);
		margin: 0;
	}

	.contacts-text {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--foreground-muted);
		margin: 0;
		max-width: 32rem;
	}

	.contacts-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.contact-card {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-sm, 0.55rem);
		border: 1px solid var(--border);
		background: var(--background-inset);
